#!/usr/bin/env python3
"""Grade a lesson's labs against the live cluster and your answers file.

  check <lesson>              run every exercise in the lesson
  check <lesson> <exercise>   run one exercise, e.g. `check 1 1.7`
  check <lesson> --init       create curriculum/answers/NN.toml (and any lesson notes) to fill in
  check --list                list lessons with checks

Exit status is 0 when nothing failed (unanswered items don't fail).
"""
import importlib
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "checks"))
from common import ANSWERS, BOLD, OFF, ROOT, Report, load_answers  # noqa: E402

LESSONS = {0: "l00", 1: "l01"}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--list":
        for n, m in LESSONS.items():
            print(n, importlib.import_module(m).TITLE)
        return 0
    try:
        lesson = int(argv[0])
        mod = importlib.import_module(LESSONS[lesson])
    except (ValueError, KeyError):
        print(f"no checks for lesson {argv[0]!r}; try --list")
        return 2

    if len(argv) > 1 and argv[1] == "--init":
        ANSWERS.mkdir(parents=True, exist_ok=True)
        f = ANSWERS / f"{lesson:02d}.toml"
        if f.exists():
            print(f"{f.relative_to(ROOT)} already exists; not overwriting")
        else:
            f.write_text(mod.TEMPLATE)
            print(f"created {f.relative_to(ROOT)}")
        if hasattr(mod, "init_extra"):
            mod.init_extra()
        return 0

    answers, f = load_answers(lesson)
    print(f"{BOLD}{mod.TITLE}{OFF}")
    if answers is None:
        print(f"(no answers file yet: `check {lesson} --init` creates {f.relative_to(ROOT)})")
    r = Report(answers)
    only = argv[1] if len(argv) > 1 else None
    if only and only not in mod.EXERCISES:
        print(f"no exercise {only}; this lesson has {', '.join(mod.EXERCISES)}")
        return 2
    for ex, fn in mod.EXERCISES.items():
        if only in (None, ex):
            fn(r)
    return r.summary()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
